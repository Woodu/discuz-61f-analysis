# 服务器配置
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# 数据库
DATABASE_URL="mysql://root:password@localhost:3306/poketb_forum?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET="your-rsa-private-key"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 加密
ENCRYPTION_KEY="your-64-char-hex-key-for-aes-256-encryption"
HASH_SALT="your-random-salt"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# 文件上传
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp,application/pdf"

# OSS (可选)
OSS_ENABLED=false
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=

# 邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@poketb.com
SMTP_PASS=

# 日志
LOG_LEVEL=debug
LOG_FILE=

# 监控
SENTRY_DSN=

# 前端地址
FRONTEND_URL=http://localhost:3000
